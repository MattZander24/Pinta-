---
import Layout from '../layouts/Layout.astro';
import CreationsGrid from '../components/creaciones/CreationsGrid.jsx';

const categoria = 'all';
---

<Layout title="Creaciones - PINTA?">
  <main class="creations-page">
    <div class="creations-background" aria-hidden="true">
      <img src="/assets/creaciones/ondaFondoPortfolio.png" alt="" />
    </div>

    <div class="creations-content">
      <header class="creations-header">
        <div class="creations-brand">
          <img
            src="/assets/creaciones/bannerPortfolio.png"
            alt=""
            class="creations-brand__banner"
            aria-hidden="true"
          />
          <h1>CREACIONES</h1>
        </div>

        <div class="creations-actions">
          <label class="visually-hidden" for="categoria-selector">Filtrar por categoría</label>
          <select id="categoria-selector" value={categoria}>
            <option value="all" selected={categoria === "all"}>Todas las categorías</option>
            <option value="graphic-design" selected={categoria === "graphic-design"}>Graphic Design</option>
            <option value="3d-modeling" selected={categoria === "3d-modeling"}>3D Modeling</option>
            <option value="motion-graphics" selected={categoria === "motion-graphics"}>Motion Graphics</option>
            <option value="clientes" selected={categoria === "clientes"}>Clientes</option>
          </select>

          <a class="creations-close" href="/" aria-label="Volver al inicio">×</a>
        </div>
      </header>

      <CreationsGrid categoria={categoria} client:load />
    </div>
  </main>
</Layout>

<script>
  const select = document.getElementById('categoria-selector');

  if (select instanceof HTMLSelectElement) {
    const updateFromUrl = () => {
      const requestedCategory = new URLSearchParams(window.location.search).get('categoria') || 'all';
      const validCategories = [...select.options].map((option) => option.value);
      select.value = validCategories.includes(requestedCategory) ? requestedCategory : 'all';
    };

    updateFromUrl();

    select.addEventListener('change', () => {
      const url = new URL(window.location.href);
      if (select.value === 'all') {
        url.searchParams.delete('categoria');
      } else {
        url.searchParams.set('categoria', select.value);
      }

      window.history.pushState({}, '', url);
      window.dispatchEvent(new Event('popstate'));
    });

    window.addEventListener('popstate', updateFromUrl);
  }
</script>

<style>
  .creations-page {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background-color: #fcfaf8;
    background-image: radial-gradient(rgba(67, 49, 39, 0.14) 0.55px, transparent 0.75px);
    background-size: 4px 4px;
  }

  .creations-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .creations-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.2;
  }

  .creations-content {
    position: relative;
    z-index: 1;
    width: min(100% - 3rem, 1170px);
    min-height: 100vh;
    min-height: 100svh;
    box-sizing: border-box;
    margin: 0 auto;
    padding: clamp(2.5rem, 8vh, 4.5rem) 0;
    display: flex;
    flex-direction: column;
  }

  .creations-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 7vh, 4rem);
  }

  .creations-brand {
    position: relative;
    width: min(455px, 46vw);
    flex: 0 1 455px;
    aspect-ratio: 2000 / 440;
  }

  .creations-brand__banner {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .creations-brand h1 {
    position: absolute;
    top: 50%;
    left: 25%;
    width: 72%;
    margin: 0;
    transform: translateY(-50%);
    color: #fff;
    font-family: var(--font-sans, "Outfit", sans-serif);
    font-size: clamp(1.7rem, 3.2vw, 2.8rem);
    font-weight: 600;
    line-height: 1.05;
    text-align: center;
  }

  .creations-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .creations-actions select {
    max-width: 13.5rem;
    padding: 0.55rem 2rem 0.55rem 0.75rem;
    border: 1px solid rgba(121, 39, 131, 0.5);
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.75);
    color: #54205b;
    font: 600 0.9rem/1.2 var(--font-sans, "Outfit", sans-serif);
  }

  .creations-actions select:focus-visible {
    outline: 3px solid rgba(121, 39, 131, 0.3);
    outline-offset: 2px;
  }

  .creations-close {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    color: #792783;
    font: 300 2rem/1 var(--font-sans, "Outfit", sans-serif);
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .creations-close:hover {
    transform: rotate(90deg);
    background-color: rgba(121, 39, 131, 0.1);
  }

  .creations-close:focus-visible {
    outline: 2px solid #792783;
    outline-offset: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .creations-content {
      width: min(100% - 2rem, 34rem);
      padding: 2rem 0;
    }

    .creations-header {
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .creations-brand {
      width: min(72vw, 360px);
      flex-basis: min(72vw, 360px);
      margin-left: -0.5rem;
    }

    .creations-brand h1 {
      font-size: clamp(1.35rem, 5vw, 2.1rem);
    }

    .creations-actions {
      align-items: flex-end;
      flex-direction: column-reverse;
      gap: 0.35rem;
    }

    .creations-actions select {
      width: min(11rem, 42vw);
      padding: 0.45rem 1.4rem 0.45rem 0.55rem;
      font-size: 0.75rem;
    }

    .creations-close {
      width: 2rem;
      height: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .creations-close {
      transition: none;
    }
  }
</style>
