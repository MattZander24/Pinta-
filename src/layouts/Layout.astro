---
import LoadingAnimation from '../components/LoadingAnimation.astro';

interface Props {
	title?: string;
	loadingMode?: 'bands' | 'idle';
}

const { title = "PINTA? - Agencia Multimedia", loadingMode } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			if (sessionStorage.getItem('returnToPortfolio') === 'true') {
				sessionStorage.removeItem('returnToPortfolio');
				document.documentElement.dataset.returnToPortfolio = 'true';
			}
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class:list={{ loading: loadingMode === 'bands' }}>
		{loadingMode && <LoadingAnimation mode={loadingMode} />}
		<slot />
		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);
			Object.assign(window, { gsap, ScrollTrigger });
		</script>
	</body>
</html>

<style>
	html {
		overflow-y: scroll;
		scrollbar-gutter: stable;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: clip;
	}
</style>
