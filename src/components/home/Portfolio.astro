---
interface Props {
  id?: string;
}

const { id = "portfolio" } = Astro.props;
---

<section id={id} class="min-h-screen bg-bg-dark text-white py-16">
  <div class="container mx-auto px-8">
    <!-- Encabezado -->
    <h2 class="text-5xl font-bold mb-12 text-center">PORTFOLIO</h2>

    <!-- Layout de 2 columnas -->
    <div class="flex gap-8">
      <!-- Columna izquierda: Menú de botones -->
      <div class="w-1/3 flex flex-col gap-4">
        <a href="/creaciones?categoria=graphic-design" class="group">
          <button class="w-full text-left px-8 py-6 bg-purple-main rounded-lg hover:bg-purple-light transition-all duration-300 border-2 border-transparent hover:border-white transform hover:translate-x-2">
            <span class="text-2xl font-bold">Graphic Design &gt;</span>
          </button>
        </a>
        
        <a href="/creaciones?categoria=3d-modeling" class="group">
          <button class="w-full text-left px-8 py-6 bg-magenta rounded-lg hover:opacity-80 transition-all duration-300 border-2 border-transparent hover:border-white transform hover:translate-x-2">
            <span class="text-2xl font-bold">3D Modeling &gt;</span>
          </button>
        </a>
        
        <a href="/creaciones?categoria=motion-graphics" class="group">
          <button class="w-full text-left px-8 py-6 bg-cyan rounded-lg hover:bg-cyan-light transition-all duration-300 border-2 border-transparent hover:border-white transform hover:translate-x-2">
            <span class="text-2xl font-bold">Motion Graphics &gt;</span>
          </button>
        </a>
        
        <a href="/creaciones?categoria=clientes" class="group">
          <button class="w-full text-left px-8 py-6 bg-yellow text-black rounded-lg hover:opacity-80 transition-all duration-300 border-2 border-transparent hover:border-white transform hover:translate-x-2">
            <span class="text-2xl font-bold">Clientes &gt;</span>
          </button>
        </a>
      </div>

      <!-- Columna derecha: Contenedor de vista previa -->
      <div class="w-2/3 bg-purple-light rounded-lg p-8 flex items-center justify-center min-h-[400px] border-2 border-purple-main">
        <div class="text-center">
          <div class="w-full h-64 bg-bg-dark rounded-lg mb-4 flex items-center justify-center">
            <p class="text-gray-400 text-xl">Vista previa del trabajo</p>
          </div>
          <p class="text-gray-300">Pasa el cursor sobre los botones para ver una vista previa</p>
        </div>
      </div>
    </div>
  </div>
</section>
