---
interface Props {
  id?: string;
}

const { id = "mision" } = Astro.props;
---

<section id={id} class="mission-section" aria-labelledby={`${id}-title`}>
  <div class="mission-grid" aria-hidden="true">
    <img src="/assets/mision/fondoMision.png" alt="" />
  </div>

  <img src="/assets/mision/stickers/boca.png" alt="" aria-hidden="true" class="mission-sticker mission-mouth" />
  <img src="/assets/mision/stickers/estrella-2.png" alt="" aria-hidden="true" class="mission-sticker mission-purple-star-top" />
  <img src="/assets/mision/stickers/corazon.png" alt="" aria-hidden="true" class="mission-sticker mission-heart" />
  <img src="/assets/mision/stickers/estrella-1.png" alt="" aria-hidden="true" class="mission-sticker mission-cyan-star" />
  <img src="/assets/mision/stickers/corona.png" alt="" aria-hidden="true" class="mission-sticker mission-crown" />
  <img src="/assets/mision/stickers/rayo.png" alt="" aria-hidden="true" class="mission-sticker mission-bolt" />
  <img src="/assets/mision/stickers/estrella-3.png" alt="" aria-hidden="true" class="mission-sticker mission-green-star" />
  <img src="/assets/mision/stickers/estrella-2.png" alt="" aria-hidden="true" class="mission-sticker mission-purple-star-bottom" />
  <img src="/assets/mision/stickers/estrella-4.png" alt="" aria-hidden="true" class="mission-sticker mission-pink-star" />

  <div class="mission-logo" aria-hidden="true">
    <img src="/assets/mision/logo.png" alt="" class="mission-logo-piece mission-logo-top" />
    <img src="/assets/mision/logo.png" alt="" class="mission-logo-piece mission-logo-bottom" />
  </div>

  <div class="mission-text">
    <h2 id={`${id}-title`}>DISFRUTAR ES<br class="desktop-break" /> PARTE DEL PROCESO</h2>
    <p>
      Somos una agencia de diseño multimedia donde las ideas fluyen, la creatividad se descontractura
      y cada proyecto es una oportunidad para experimentar, crear y disfrutar del proceso.
    </p>
  </div>
</section>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const missionSection = document.querySelector('.mission-section');
    const missionLogoPieces = missionSection?.querySelectorAll('.mission-logo-piece');
    const missionText = missionSection?.querySelector('.mission-text');

    if (!missionSection || !missionLogoPieces?.length || !missionText) return;
    if (typeof gsap === 'undefined') {
      console.error('GSAP did not load; the mission animation was not initialized.');
      return;
    }

    missionSection.classList.add('is-animation-ready');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lockedScrollY = window.scrollY;
    let isAutoScrolling = false;
    let isLocked = false;

    const preventScroll = (event) => event.preventDefault();
    const preventScrollKeys = (event) => {
      if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '].includes(event.key)) {
        event.preventDefault();
      }
    };
    const keepScrollLocked = () => {
      if (isLocked && !isAutoScrolling && window.scrollY !== lockedScrollY) {
        window.scrollTo(0, lockedScrollY);
      }
    };

    const unlockScroll = () => {
      isLocked = false;
      document.removeEventListener('wheel', preventScroll);
      document.removeEventListener('touchmove', preventScroll);
      document.removeEventListener('keydown', preventScrollKeys);
      window.removeEventListener('scroll', keepScrollLocked);
    };

    const playMissionAnimation = () => {
      isLocked = true;
      lockedScrollY = window.scrollY;
      document.addEventListener('wheel', preventScroll, { passive: false });
      document.addEventListener('touchmove', preventScroll, { passive: false });
      document.addEventListener('keydown', preventScrollKeys);
      window.addEventListener('scroll', keepScrollLocked, { passive: true });

      const sectionRect = missionSection.getBoundingClientRect();
      const targetY = Math.max(
        0,
        window.scrollY + sectionRect.top + (sectionRect.height - window.innerHeight) / 2,
      );
      const scrollPosition = { y: window.scrollY };
      isAutoScrolling = true;

      gsap.to(scrollPosition, {
        y: targetY,
        duration: reduceMotion ? 0 : 0.9,
        ease: 'power2.inOut',
        onUpdate: () => {
          window.scrollTo(0, scrollPosition.y);
          lockedScrollY = scrollPosition.y;
        },
        onComplete: () => {
          lockedScrollY = targetY;
          isAutoScrolling = false;
          gsap.delayedCall(0.5, () => {
            const timeline = gsap.timeline({
              onComplete: () => gsap.delayedCall(0.5, unlockScroll),
            });

            if (reduceMotion) {
              timeline
                .to(missionLogoPieces, { autoAlpha: 0, duration: 0.2 }, 0)
                .to(missionText, { opacity: 1, y: 0, duration: 0.2 }, 0);
              return;
            }

            timeline
              .to(missionLogoPieces[0], {
                yPercent: -45,
                opacity: 0.28,
                filter: 'blur(8px)',
                duration: 1.2,
                ease: 'power3.inOut',
              }, 0)
              .to(missionLogoPieces[1], {
                yPercent: 36,
                opacity: 0.28,
                filter: 'blur(8px)',
                duration: 1.2,
                ease: 'power3.inOut',
              }, 0)
              .to(missionText, {
                opacity: 1,
                y: 0,
                duration: 0.9,
                ease: 'power2.out',
              }, 0.3);
          });
        },
      });
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry && entry.intersectionRatio >= 0.66) {
          observer.disconnect();
          playMissionAnimation();
        }
      },
      { threshold: 0.66 },
    );

    observer.observe(missionSection);
  });
</script>

<style>
  .mission-section {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    isolation: isolate;
    display: grid;
    place-items: center;
    background: #fcfaf8;
  }

  .mission-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    /*overflow: hidden;*/
  }

  .mission-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.12;
  }

  .mission-logo {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: min(48vw, 650px);
    aspect-ratio: 3649 / 2128;
    transform: translate(-50%, -50%);
  }

  .mission-logo-piece {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    will-change: transform, opacity, filter;
  }

  .mission-logo-top {
    clip-path: inset(0 0 50% 0);
  }

  .mission-logo-bottom {
    clip-path: inset(50% 0 0 0);
  }

  .mission-text {
    position: relative;
    z-index: 2;
    width: min(48vw, 650px);
    color: #333;
    font-family: var(--font-sans, "Outfit", sans-serif);
  }

  .mission-section.is-animation-ready .mission-text {
    opacity: 0;
    transform: translateY(20px);
  }

  .mission-text h2 {
    margin: 0 0 0.6rem;
    color: #792783;
    font-size: clamp(1.75rem, 3.8vw, 3.3rem);
    font-weight: 800;
    line-height: 1.08;
  }

  .mission-text p {
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    font-weight: 500;
    line-height: 1.3;
  }

  .mission-sticker {
    position: absolute;
    z-index: 3;
    height: auto;
    object-fit: contain;
    pointer-events: none;
  }

  .mission-mouth {
    top: 6%;
    left: 3%;
    width: min(8vw, 112px);
  }

  .mission-purple-star-top {
    top: 11%;
    left: 13%;
    width: min(7vw, 98px);
  }

  .mission-heart {
    top: 55%;
    left: 87%;
    width: min(7vw, 170px);
  }

  .mission-cyan-star {
    top: 7%;
    right: 4%;
    width: min(11vw, 148px);
  }

  .mission-crown {
    top: 42%;
    left: 2%;
    width: min(14vw, 190px);
  }

  .mission-bolt {
    bottom: 13%;
    left: 15%;
    width: min(6vw, 82px);
  }

  .mission-green-star {
    top: 36%;
    right: 14%;
    width: min(6vw, 82px);
  }

  .mission-purple-star-bottom {
    right: 13%;
    bottom: 9%;
    width: min(7vw, 98px);
  }

  .mission-pink-star {
    right: 4%;
    bottom: 11%;
    width: min(6vw, 82px);
  }

  @media (max-width: 760px) {
    .mission-logo {
      width: 82vw;
    }

    .mission-text {
      width: min(82vw, 36rem);
    }

    .mission-text h2 {
      font-size: clamp(1.7rem, 7vw, 2.5rem);
    }

    .mission-text p {
      font-size: clamp(0.95rem, 3.5vw, 1.15rem);
    }

    .desktop-break {
      display: none;
    }

    .mission-mouth {
      top: 5%;
      left: 3%;
      width: 17vw;
    }

    .mission-purple-star-top {
      top: 14%;
      left: 22%;
      width: 13vw;
    }

    .mission-heart {
      top: 6%;
      left: auto;
      right: 27%;
      width: 19vw;
    }

    .mission-cyan-star {
      top: 3%;
      right: 0;
      width: 20vw;
    }

    .mission-crown {
      top: 41%;
      left: -3%;
      width: 20vw;
    }

    .mission-bolt {
      bottom: 10%;
      left: 8%;
      width: 12vw;
    }

    .mission-green-star {
      top: 37%;
      right: 5%;
      width: 12vw;
    }

    .mission-purple-star-bottom {
      right: 20%;
      bottom: 7%;
      width: 13vw;
    }

    .mission-pink-star {
      right: 4%;
      bottom: 9%;
      width: 11vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mission-logo-piece,
    .mission-text {
      will-change: auto;
    }
  }
</style>
