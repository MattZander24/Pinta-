---
interface Props {
  id?: string;
}

const { id = "mision" } = Astro.props;
---

<section id={id} class="min-h-screen bg-bg-light grid-pattern relative overflow-hidden py-16">
  <!-- Stickers decorativos -->
  <div class="absolute top-10 left-10 w-16 h-16 bg-yellow rounded-full opacity-60"></div>
  <div class="absolute top-20 right-20 w-12 h-12 bg-magenta rounded-full opacity-60"></div>
  <div class="absolute bottom-20 left-1/4 w-14 h-14 bg-cyan rounded-full opacity-60"></div>
  <div class="absolute bottom-10 right-10 w-10 h-10 bg-purple-main rounded-full opacity-60"></div>

  <div class="container mx-auto px-8 flex flex-col items-center justify-center min-h-[calc(100vh-8rem)]">
    <!-- Contenedor central para logo PINTA? -->
    <div class="relative mb-12">
      <!-- Logo dividido en dos mitades (preparado para GSAP) -->
      <div class="relative w-64 h-64">
        <!-- Mitad superior -->
        <div class="logo-half logo-top absolute top-0 left-0 w-full h-1/2 bg-purple-main rounded-t-3xl flex items-center justify-center border-b-4 border-purple-light">
          <span class="text-4xl font-bold text-white">PINTA</span>
        </div>
        <!-- Mitad inferior -->
        <div class="logo-half logo-bottom absolute bottom-0 left-0 w-full h-1/2 bg-purple-light rounded-b-3xl flex items-center justify-center border-t-4 border-purple-main">
          <span class="text-4xl font-bold text-white">?</span>
        </div>
      </div>
    </div>

    <!-- Texto revelado -->
    <div class="text-center max-w-3xl">
      <h3 class="text-4xl font-bold text-purple-main mb-6">DISFRUTAR ES PARTE DEL PROCESO</h3>
      <p class="text-xl text-gray-700 leading-relaxed">
        Somos una agencia de diseño multimedia donde las ideas fluyen, la creatividad se descontractura y cada proyecto es una oportunidad para experimentar, crear y disfrutar del proceso.
      </p>
    </div>
  </div>
</section>

<style>
  .logo-half {
    transition: transform 0.5s ease-in-out;
  }
  
  .logo-top:hover {
    transform: translateY(-10px);
  }
  
  .logo-bottom:hover {
    transform: translateY(10px);
  }
</style>
