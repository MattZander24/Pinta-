---
interface Props {
  id?: string;
}

const { id = "contacto" } = Astro.props;
---

<section id={id} class="contact-section" aria-labelledby={`${id}-title`}>
  <div class="contact-background" aria-hidden="true">
    <img src="/assets/contacto/fondoContacto.png" alt="" />
  </div>

  <img src="/assets/contacto/stickers/estrella-4.png" alt="" aria-hidden="true" class="contact-sticker contact-star-green" />
  <img src="/assets/contacto/stickers/estrella-5.png" alt="" aria-hidden="true" class="contact-sticker contact-star-pink" />
  <img src="/assets/contacto/stickers/estrella-2.png" alt="" aria-hidden="true" class="contact-sticker contact-star-purple" />
  <img src="/assets/contacto/stickers/estrella-3.png" alt="" aria-hidden="true" class="contact-sticker contact-star-lime" />
  <img src="/assets/contacto/stickers/estrella-1.png" alt="" aria-hidden="true" class="contact-sticker contact-star-cyan" />

  <main class="contact-main">
    <h2 id={`${id}-title`} class="contact-heading">HABLA CON PINTA?</h2>

    <form class="contact-form" data-contact-form>
      <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY} />
      <input type="hidden" name="subject" value="Consulta via PINTA? Landing Page" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <label class="visually-hidden" for={`${id}-nombre`}>Nombre</label>
      <input
        type="text"
        id={`${id}-nombre`}
        name="name"
        placeholder="NOMBRE"
        autocomplete="name"
        required
      />

      <label class="visually-hidden" for={`${id}-email`}>Email</label>
      <input
        type="email"
        id={`${id}-email`}
        name="email"
        placeholder="E-MAIL"
        autocomplete="email"
        required
      />

      <label class="visually-hidden" for={`${id}-consulta`}>Consulta</label>
      <textarea
        id={`${id}-consulta`}
        name="message"
        rows="4"
        placeholder="CONTANOS..."
        required
      ></textarea>

      <div class="contact-submit">
        <button type="submit" data-contact-submit>ENVIAR</button>
      </div>

      <div data-contact-feedback class="contact-feedback" aria-live="polite"></div>
    </form>
  </main>

  <footer class="contact-footer">
    <img class="contact-footer__logo" src="/assets/mision/logo.png" alt="PINTA?" />
    <p>Disfrutar es parte del proceso</p>
    <a href="#" aria-label="Instagram de Agencia Pinta">@agenciapinta</a>
  </footer>
</section>

<script>
  const form = document.querySelector('[data-contact-form]');
  const submitBtn = document.querySelector('[data-contact-submit]');
  const feedback = document.querySelector('[data-contact-feedback]');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);

    const originalText = submitBtn.textContent;
    submitBtn.textContent = "ENVIANDO...";
    submitBtn.disabled = true;
    feedback.textContent = '';
    feedback.className = 'contact-feedback';

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData
      });

      const data = await response.json();

      if (data.success) {
        feedback.textContent = "¡Mensaje enviado con éxito! Nos pondremos en contacto pronto.";
        feedback.className = 'contact-feedback contact-feedback--success';
        form.reset();
      } else {
        feedback.textContent = "Ocurrió un error al enviar la consulta. Intentá nuevamente.";
        feedback.className = 'contact-feedback contact-feedback--error';
      }

    } catch (error) {
      feedback.textContent = "Ocurrió un error al enviar la consulta. Intentá nuevamente.";
      feedback.className = 'contact-feedback contact-feedback--error';
    } finally {
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .contact-section {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    /* overflow: hidden; */
    display: flex;
    flex-direction: column;
    isolation: isolate;
    background-color: #fcfaf8;
    background-image: radial-gradient(rgba(67, 49, 39, 0.13) 0.55px, transparent 0.75px);
    background-size: 4px 4px;
    color: #111;
    font-family: var(--font-sans, "Outfit", sans-serif);
  }

  .contact-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .contact-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .contact-sticker {
    position: absolute;
    z-index: 1;
    height: auto;
    object-fit: contain;
    pointer-events: none;
  }

  .contact-star-green {
    top: 3%;
    left: 5.5%;
    width: min(5.5vw, 76px);
  }

  .contact-star-pink {
    top: -4%;
    left: 13%;
    width: min(5.5vw, 76px);
  }

  .contact-star-purple {
    top: 10%;
    left: 10%;
    width: min(7vw, 96px);
  }

  .contact-star-lime {
    right: 9%;
    bottom: 28%;
    width: min(4vw, 56px);
  }

  .contact-star-cyan {
    right: 3%;
    bottom: 14%;
    width: min(8vw, 110px);
  }

  .contact-main {
    position: relative;
    z-index: 2;
    width: min(100% - 2rem, 700px);
    margin: 0 auto;
    padding: clamp(4rem, 11vh, 6rem) 0 3rem;
    flex: 1;
  }

  .contact-heading {
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    padding: 0.035em 0.22em 0.08em;
    background: #10aaa6;
    box-shadow: 0 5px 9px rgba(0, 0, 0, 0.38);
    color: #fff;
    font-size: clamp(2rem, 5.3vw, 4.25rem);
    font-weight: 500;
    line-height: 1.15;
    text-align: center;
  }

  .contact-form {
    width: min(100%, 502px);
    margin: clamp(2.5rem, 8vh, 4rem) auto 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .contact-form input,
  .contact-form textarea {
    box-sizing: border-box;
    width: 100%;
    border: 2px solid #10aaa6;
    border-radius: 0.8rem;
    background: rgba(255, 255, 255, 0.92);
    color: #222;
    font: 500 0.9rem/1.4 var(--font-sans, "Outfit", sans-serif);
    transition: box-shadow 160ms ease, border-color 160ms ease;
  }

  .contact-form input {
    height: 3rem;
    padding: 0 0.7rem;
  }

  .contact-form textarea {
    min-height: 7.4rem;
    padding: 0.8rem 0.7rem;
    resize: vertical;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #777;
    opacity: 1;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: #078c88;
    outline: none;
    box-shadow: 0 0 0 3px rgba(16, 170, 166, 0.2);
  }

  .contact-submit {
    display: flex;
    justify-content: flex-end;
  }

  .contact-submit button {
    min-width: 6.9rem;
    min-height: 2.4rem;
    padding: 0.45rem 1rem;
    border: 0;
    border-radius: 0.55rem;
    background: #10aaa6;
    color: #fff;
    cursor: pointer;
    font: 600 1rem/1 var(--font-sans, "Outfit", sans-serif);
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .contact-submit button:hover {
    background: #078c88;
    transform: translateY(-2px);
  }

  .contact-submit button:focus-visible {
    outline: 3px solid #111;
    outline-offset: 3px;
  }

  .contact-footer {
    position: relative;
    z-index: 3;
    box-sizing: border-box;
    min-height: 4.8rem;
    padding: 0.65rem 2.5%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    background: #fff;
  }

  .contact-footer__logo {
    justify-self: start;
    width: min(8vw, 112px);
    height: auto;
  }

  .contact-footer p {
    margin: 0;
    font-size: clamp(0.9rem, 1.8vw, 1.4rem);
    font-weight: 600;
    text-align: center;
  }

  .contact-footer a {
    justify-self: end;
    color: #111;
    font-size: clamp(0.8rem, 1.45vw, 1.1rem);
    font-weight: 600;
    text-decoration: none;
  }

  .contact-footer a:hover {
    color: #792783;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .contact-feedback {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.55rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: center;
  }

  .contact-feedback--success {
    background-color: #d1fae5;
    color: #065f46;
    border: 1px solid #10b981;
  }

  .contact-feedback--error {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #ef4444;
  }

  @media (max-width: 640px) {
    .contact-main {
      padding-top: 5rem;
      padding-bottom: 2rem;
    }

    .contact-heading {
      font-size: clamp(1.7rem, 8.5vw, 3rem);
    }

    .contact-form {
      margin-top: 2.7rem;
      gap: 1rem;
    }

    .contact-footer {
      min-height: 4.2rem;
      padding: 0.55rem 0.75rem;
      grid-template-columns: auto 1fr auto;
      gap: 0.5rem;
    }

    .contact-footer__logo {
      width: 4.5rem;
    }

    .contact-footer p {
      font-size: clamp(0.68rem, 3vw, 0.9rem);
    }

    .contact-footer a {
      font-size: clamp(0.65rem, 2.8vw, 0.85rem);
    }

    .contact-star-purple {
      left: 7%;
      top: 13%;
      width: 13vw;
    }

    .contact-star-green {
      left: 3%;
      top: 4%;
      width: 10vw;
    }

    .contact-star-pink {
      left: 20%;
      top: -3%;
      width: 10vw;
    }

    .contact-star-lime {
      right: 17%;
      bottom: 24%;
      width: 8vw;
    }

    .contact-star-cyan {
      right: 3%;
      bottom: 10%;
      width: 17vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form input,
    .contact-form textarea,
    .contact-submit button {
      transition: none;
    }
  }
</style>
