---
interface Props {
  categoria?: string;
}

const { categoria = "all" } = Astro.props;
---

<div class="grid grid-cols-3 gap-8 mt-8">
  <!-- Tarjeta 1: Nintendo Switch 3D -->
  <div class="bg-purple-main rounded-t-lg overflow-hidden shadow-xl hover:shadow-2xl transition-shadow">
    <div class="h-64 bg-bg-dark flex items-center justify-center">
      <div class="text-center">
        <div class="w-32 h-32 bg-cyan rounded-lg mx-auto mb-4 opacity-50"></div>
        <p class="text-gray-400">Placeholder 3D Model</p>
      </div>
    </div>
    <div class="p-6">
      <h3 class="text-xl font-bold text-white mb-2">Nintendo Switch 3D</h3>
      <p class="text-gray-300">Modelado 3D</p>
    </div>
  </div>

  <!-- Tarjeta 2: Cámara Vintage -->
  <div class="bg-purple-main rounded-t-lg overflow-hidden shadow-xl hover:shadow-2xl transition-shadow">
    <div class="h-64 bg-bg-dark flex items-center justify-center">
      <div class="text-center">
        <div class="w-32 h-32 bg-magenta rounded-full mx-auto mb-4 opacity-50"></div>
        <p class="text-gray-400">Placeholder Image</p>
      </div>
    </div>
    <div class="p-6">
      <h3 class="text-xl font-bold text-white mb-2">Cámara Vintage</h3>
      <p class="text-gray-300">Graphic Design</p>
    </div>
  </div>

  <!-- Tarjeta 3: Granada Pinta -->
  <div class="bg-purple-main rounded-t-lg overflow-hidden shadow-xl hover:shadow-2xl transition-shadow">
    <div class="h-64 bg-bg-dark flex items-center justify-center">
      <div class="text-center">
        <div class="w-32 h-32 bg-yellow rounded-lg mx-auto mb-4 opacity-50"></div>
        <p class="text-gray-400">Placeholder Motion Graphics</p>
      </div>
    </div>
    <div class="p-6">
      <h3 class="text-xl font-bold text-white mb-2">Granada Pinta</h3>
      <p class="text-gray-300">Motion Graphics</p>
    </div>
  </div>
</div>
