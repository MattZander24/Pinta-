---
interface Props {
	mode: 'bands' | 'idle';
}

const { mode } = Astro.props;
---

<div
	id="loading-animation"
	class:list={['loading-animation', { 'is-hidden': mode === 'idle' }]}
	data-mode={mode}
	aria-hidden="true"
>
	<div class="loading-overlay"></div>
	<div class="loading-stripes">
		<div class="stripe stripe--violet"></div>
		<div class="stripe stripe--cyan"></div>
		<div class="stripe stripe--yellow"></div>
		<div class="stripe stripe--pink"></div>
	</div>
</div>

<style>
	.loading-animation {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 9999;
		pointer-events: auto;
	}

	.loading-animation.is-hidden {
		visibility: hidden;
		pointer-events: none;
	}

	.loading-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background-color: #000;
		opacity: 1;
	}

	.loading-stripes {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
	}

	.stripe {
		flex: 1;
		height: 100%;
		transform: translateY(0);
	}

	.stripe--violet {
		background-color: #77267f;
	}

	.stripe--cyan {
		background-color: #0eb0a9;
	}

	.stripe--yellow {
		background-color: #fdd306;
	}

	.stripe--pink {
		background-color: #eb0282;
	}

	:global(html[data-return-to-portfolio="true"] #loading-animation .loading-overlay) {
		opacity: 0;
	}
</style>

<script>
	import { gsap } from 'gsap';

	const loadingAnimation = document.getElementById('loading-animation');

	if (loadingAnimation) {
		const overlay = loadingAnimation.querySelector('.loading-overlay');
		const stripes = loadingAnimation.querySelectorAll('.stripe');
		const mode = loadingAnimation.dataset.mode;
		const returningToPortfolio = document.documentElement.dataset.returnToPortfolio === 'true';
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let lockedScrollY: number | null = null;

		const restoreScrollPosition = () => {
			if (lockedScrollY !== null && window.scrollY !== lockedScrollY) {
				window.scrollTo(0, lockedScrollY);
			}
		};

		const preventScrollKey = (event: KeyboardEvent) => {
			if (['ArrowDown', 'ArrowUp', 'End', 'Home', 'PageDown', 'PageUp', ' '].includes(event.key)) {
				event.preventDefault();
			}
		};

		const lockPageScroll = () => {
			if (lockedScrollY !== null) return;
			lockedScrollY = window.scrollY;
			document.addEventListener('wheel', preventDefaultScroll, { passive: false });
			document.addEventListener('touchmove', preventDefaultScroll, { passive: false });
			document.addEventListener('keydown', preventScrollKey, true);
			window.addEventListener('scroll', restoreScrollPosition);
			document.body.classList.add('loading');
		};

		const unlockPageScroll = () => {
			document.removeEventListener('wheel', preventDefaultScroll);
			document.removeEventListener('touchmove', preventDefaultScroll);
			document.removeEventListener('keydown', preventScrollKey, true);
			window.removeEventListener('scroll', restoreScrollPosition);
			lockedScrollY = null;
			document.body.classList.remove('loading');
		};

		function preventDefaultScroll(event: Event) {
			event.preventDefault();
		}

		if (returningToPortfolio && window.location.hash) {
			document.getElementById(window.location.hash.slice(1))?.scrollIntoView();
		}

		const finishAnimation = () => {
			loadingAnimation.classList.add('is-hidden');
			unlockPageScroll();
			delete document.documentElement.dataset.returnToPortfolio;
		};

		const runPortfolioReveal = () => {
			if (reducedMotion) {
				gsap.set(stripes, { yPercent: -100 });
				finishAnimation();
				return;
			}

			gsap.timeline({ onComplete: finishAnimation })
				.to({}, { duration: 0.5 })
				.to(stripes, {
					yPercent: -100,
					duration: 0.9,
					ease: 'power3.inOut',
					stagger: 0.16,
				});
		};

		if (returningToPortfolio) {
			gsap.set(overlay, { opacity: 0 });
			gsap.set(stripes, { yPercent: 0 });
			lockPageScroll();
			runPortfolioReveal();
		} else if (mode === 'bands') {
			lockPageScroll();
			if (reducedMotion) {
				finishAnimation();
			} else {
				gsap.timeline({ onComplete: () => finishAnimation() })
					.to(overlay, {
						opacity: 0,
						duration: 0.8,
						ease: 'power2.inOut',
					})
					.to({}, { duration: 0.5 })
					.to(stripes, {
						yPercent: -100,
						duration: 0.9,
						ease: 'power3.inOut',
						stagger: 0.16,
					});
			}
		}

		if (mode === 'idle') {
			document.addEventListener('click', (event) => {
				if (!(event.target instanceof Element)) return;
				const link = event.target.closest('a[data-return-to-portfolio]');
				if (
					!(link instanceof HTMLAnchorElement) ||
					event.defaultPrevented ||
					event.button !== 0 ||
					event.metaKey ||
					event.ctrlKey ||
					event.shiftKey ||
					event.altKey
				) return;

				const destination = new URL(link.href, window.location.href);
				if (destination.origin !== window.location.origin) return;

				event.preventDefault();
				if (reducedMotion) {
					window.location.assign(destination.href);
					return;
				}

				lockPageScroll();
				loadingAnimation.classList.remove('is-hidden');
				gsap.set(overlay, { opacity: 0 });
				gsap.set(stripes, { yPercent: -100 });
				gsap.to(stripes, {
					yPercent: 0,
					duration: 0.9,
					ease: 'power3.inOut',
					stagger: { each: 0.16, from: 'start' },
					onComplete: () => {
						sessionStorage.setItem('returnToPortfolio', 'true');
						window.location.assign(destination.href);
					},
				});
			});
		}
	}
</script>
